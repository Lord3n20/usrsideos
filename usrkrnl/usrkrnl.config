# usrkrnl defaults, merged on top of the machine-specific minimal config.
# Goal: noticeably more responsive, battery cost ~1 %.
CONFIG_LOCALVERSION="-usr"
# CONFIG_LOCALVERSION_AUTO is not set

# Scheduler / latency
CONFIG_SCHED_BORE=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
# sched_ext needs BTF, and nothing installs a BPF scheduler (scx); BORE is the scheduler
# CONFIG_SCHED_CLASS_EXT is not set

# Compiler: clang + ThinLTO, tuned for the build machine's CPU
CONFIG_X86_NATIVE_CPU=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_THIN=y

# Memory
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# Boot straight from the EFI firmware, no initramfs, no bootloader
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Modules: zstd-compressed like Arch
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# Build-time self test of the x86 instruction decoder: a host program that does not build
# against musl (Alpine: __attribute_const__ is glibc) and is of no use for usrkrnl
# CONFIG_X86_DECODER_SELFTEST is not set

# No debug info and no BTF: pahole (BTF from DWARF) needs several GB for vmlinux and got
# OOM-killed on 8 GB machines; DWARF also makes the build slower and the tree much bigger.
# Nothing on the system uses BTF (no bpftrace/scx/libbpf CO-RE tools installed).
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
