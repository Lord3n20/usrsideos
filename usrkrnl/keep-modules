# Modules that localmodconfig never removes, whatever was loaded when setup ran.
# One module name per line (as in lsmod; - and _ are the same), # starts a comment.
# They are kept with the value of the base config (usually =m), so only drivers the
# base config has can be kept. Unknown names are ignored.
#
# Why: the live system of an installer often has no GPU, no Bluetooth adapter or no
# sound device in use (a VM, the Gentoo minimal ISO without DRM), and an eGPU, a dock
# or a headset may simply not be plugged in. Without these the desktop does not start.

# graphics: DRM core, firmware framebuffer, GPUs (Intel, AMD, NVIDIA nouveau), VMs
drm
drm_kms_helper
simpledrm
i915
xe
amdgpu
nouveau
virtio_gpu
bochs
qxl
vmwgfx

# Bluetooth (bluetoothd fails without the bluetooth module)
bluetooth
btusb
btintel
btrtl
btbcm
btmtk

# input: USB/I2C keyboards, mice, touchpads, touchscreens
hid_generic
usbhid
i2c_hid
i2c_hid_acpi
hid_multitouch

