#!/usr/bin/env bash
# UsrsideOS installer – run as root from the live ISO of the base system:
#
#   Arch:   pacman -Sy git && git clone https://github.com/Lord3n20/usrsideos && usrsideos/install
#   Void:   xbps-install -Sy git && git clone https://github.com/Lord3n20/usrsideos && usrsideos/install
#   Gentoo: git is not on the minimal ISO, use the tarball:
#           wget https://github.com/Lord3n20/usrsideos/archive/main.tar.gz && tar xf main.tar.gz && usrsideos-main/install
#   Alpine: standard ISO, log in as root; network (Wi-Fi: asks for it) and a mirror first:
#           setup-interfaces -r && setup-apkrepos -c1 && apk add bash git && git clone https://github.com/Lord3n20/usrsideos && usrsideos/install
#
# The base system is detected from the booted ISO; os/<id>.sh does everything distribution specific.
# Menu like archinstall: set the options, then "Install".
#
# Unattended (tests): install --answers FILE. FILE is a bash snippet that sets DISK, USERNAME,
# PASSWORD and optionally any other setting below (e.g. USRKRNL=0); the disk is erased without asking.
# PROFILE=minimal|desktop (default minimal) presets everything else; single options override it:
# the upper-case option keys from OPTIONS below (DESKTOP=1, BROWSER=0, YAY=1 or AUR=1, …), AUTOLOGIN,
# USRKRNL and H_*. Unset or empty = value of the profile.
# TEST_SSH_KEY="ssh-ed25519 …" (answers only) additionally installs and enables sshd with that key
# for root and the user, for automated tests in a VM. TEST_CACHEDIR=DIR (answers only, Arch) adds a
# read-only package cache (e.g. the host cache in the VM) for faster test runs.
#
# Backend contract (os/*.sh): OS_NAME OS_KERNEL_NAME FREE_HINT COMMUNITY SESSION_CMD IWD_DNS SSH_PKG
# BASE (always) BUILD_PKGS (compiler/make: hopd, usrkrnl, yay) KERNEL_PKGS (usrkrnl) PKG[option]
# AUR[option] (Arch) BROWSER_NAME POLKIT_SPAWN UCODE_INTEL UCODE_AMD FS_PKG_btrfs FS_PKG_xfs
# (tools of the chosen root fs), functions os_live_tools os_chroot os_bootstrap os_locale os_enable
# os_services os_extra_services os_autologin os_sound os_community os_kernel_hook os_hopd_service
# os_confirm_service os_freeze_kernel os_finish. Optional: OS_LIKE (ID_LIKE of the new system, default the
# backend id), OS_AUR=1 (aur: packages possible), OS_INITRAMFS=0 (fallback kernel without initramfs), functions
# os_answers (check backend keys of the answers file), os_menu_label/os_menu (one more menu entry), os_prepare
# (runs once before the installation, after answers/menu), os_offline (no network: 0 = the backend installs offline anyway). An option without packages in PKG/AUR is not offered on that backend. Helpers for backends: log, die (aborts), warn (goes on; shown in
# the final dialog, for optional parts such as sound).
set -euo pipefail
# nothing from the live environment: exported functions (BASH_FUNC_*) and startup files of
# child shells (BASH_ENV, ENV); variables are handled where the answers file is read
for f in $(compgen -A function); do unset -f "$f"; done
unset f BASH_ENV ENV

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
MNT=/mnt
LOG=/tmp/usrsideos-install.log
ANSWERS=""
if [[ ${1:-} == --answers ]]; then ANSWERS=$(readlink -f "${2:?--answers needs a file}"); fi
# dry run for the live medium (rcyay bootstrap/iso): install --print-packages [OPTION …] prints every package any
# variant may install ("repo NAME" / "aur NAME"; all inits, all options except the ones named, usrkrnl, both
# microcode and root fs packages). No root, no network, no disk. Backend: INSTALL_OS (default usrside).
PRINT=0 PRINT_WITHOUT=""
if [[ ${1:-} == --print-packages ]]; then PRINT=1; shift; PRINT_WITHOUT=" $* "; LOG=/dev/null; fi

LIVE_ID=$(. /etc/os-release 2>/dev/null; echo "${ID:-}")
((PRINT)) && LIVE_ID=${INSTALL_OS:-usrside}
case $LIVE_ID in
	# pure UsrsideOS (own live system, os/usrside.sh); the glibc images of the rcyay bootstrap still say
	# ID=arch (Arch filesystem package), they are recognised by the init list and rcyay
	usrside) OS=usrside ;;
	arch) if ((PRINT)); then OS=arch; elif [[ -s /usr/share/usrside/inits ]] && command -v rcyay >/dev/null; then OS=usrside; else OS=arch; fi ;;
	void|gentoo|alpine) OS=$LIVE_ID ;;
	*) echo "Unsupported live system '${LIVE_ID:-unknown}'. Boot the UsrsideOS, Arch, Void, Gentoo or Alpine ISO." >&2; exit 1 ;;
esac
OS_LIKE="" OS_AUR=0 OS_INITRAMFS=1
[[ $OS != arch ]] || OS_AUR=1
# shellcheck source=os/arch.sh
. "$HERE/os/$OS.sh"
TITLE="UsrsideOS installer ($OS_NAME)"

# ---------------------------------------------------------------- settings (defaults)
DISK=""
KEYMAP=de-latin1
LOCALE=de_DE.UTF-8
TIMEZONE=Europe/Berlin
HOSTNAME_=usrside
USERNAME=""
PASSWORD=""
# empty = set by the profile (minimal: all off; desktop: see apply_profile)
PROFILE=""
AUTOLOGIN=""
USRKRNL=""
KERNEL_ARGS="quiet"
# root filesystem (the ESP is always vfat)
FS=btrfs                     # btrfs | xfs
BTRFS_SUBVOLS="@home"        # besides @ (root): any of @home @var_log @cache @snapshots; "flat" = none at all
BTRFS_COMPRESS=zstd:1        # zstd:1 … zstd:15 | lzo | none
EXTRA_REPO=()
EXTRA_AUR=()
TEST_SSH_KEY=""
# shellcheck disable=SC2034  # used by os/arch.sh
TEST_CACHEDIR=""
# hopd (values go into its config.h)
H_STROM="" H_LUEFTER="" H_EGPU="" H_AKKULOG="" H_NIRI=""
H_PL1_AC=45 H_PL2_AC=64 H_PL1_BAT=12 H_PL2_BAT=20
H_BRIGHT_BAT=40 H_PANEL=eDP-1 H_MODE_AC="" H_MODE_BAT="" H_ECORES=0

# optional software: key, required keys, state in the desktop profile (on/off/hw = if the hardware
# is there), label. The minimal profile has all of them off. Packages per backend: PKG/AUR in os/*.sh.
OPTIONS=(
	desktop     ""                 on  "niri desktop (niri, kitty, xwayland-satellite, portal, clipboard, fonts)"
	waybar      desktop            on  "waybar (top bar)"
	rofi        desktop            on  "rofi (app launcher, Mod+Space)"
	mako        desktop            on  "mako (notifications)"
	lock        desktop            on  "Lock screen + idle lock (Mod+L)"
	polkit      desktop            on  "polkit agent (password prompts of apps)"
	swaybg      desktop            on  "swaybg (plain wallpaper colour)"
	sound       ""                 on  "Sound: PulseAudio + pulsemixer"
	bluetooth   ""                 on  "Bluetooth (bluez)"
	sound_bt    "sound bluetooth"  on  "PulseAudio Bluetooth module"
	ssh         ""                 on  "OpenSSH (client; the server is not enabled)"
	wireguard   ""                 on  "WireGuard tools"
	neovim      ""                 on  "neovim (editor)"
	btop        ""                 on  "btop (process monitor)"
	fastfetch   ""                 on  "fastfetch (system info with UsrsideOS logo)"
	bashcomp    ""                 on  "bash-completion"
	fzf         ""                 on  "fzf (fuzzy finder)"
	tmux        ""                 on  "tmux (terminal multiplexer)"
	less        ""                 on  "less (pager)"
	unzip       ""                 on  "unzip"
	wget        ""                 on  "wget"
	pkgtools    ""                 on  "Package cache cleanup (pacman-contrib, weekly paccache)"
	mpv         ""                 on  "mpv (video player)"
	zathura     ""                 on  "zathura (PDF viewer)"
	feh         ""                 on  "feh (image viewer)"
	browser     ""                 on  "Web browser"
	yay         ""                 on  "yay (AUR helper)"
	intel_media ""                 hw  "Intel video acceleration (intel-media-driver)"
	nvidia      ""                 hw  "NVIDIA driver"
	bolt        ""                 hw  "Thunderbolt device manager (bolt)"
	tuxedo      ""                 hw  "TUXEDO laptop drivers"
	printing    ""                 off "Printing + scanning (CUPS)"
	fish        ""                 off "fish shell"
	office      ""                 off "LibreOffice"
	games       ""                 off "Steam + MangoHud"
	latex       ""                 off "LaTeX (TeX Live base)"
)
# option switches come only from the answers file or the menu, never from the environment: a live
# system may export the same names (Gentoo: LESS='-R -M --shift 5'; BROWSER, TMUX inside tmux …).
# Every other setting has its default above, so the environment cannot reach it either.
for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do unset "${OPTIONS[i]^^}"; done
declare -A SEL=()   # option key -> 0/1
declare -A EXPL=()  # keys chosen explicitly (answers file, changed in the menu) -> 1
RESOLVED="" CONFLICT=""

# ---------------------------------------------------------------- helpers
ERRFILE=/tmp/usrsideos-error
NOTEFILE=/tmp/usrsideos-notes
SUDO_TMP=99-installer   # passwordless sudo for the user, only while installing
# during the installation stdout belongs to the progress gauge: everything else goes to the log
log()  { printf '\n==> %s\n' "$*" >>"$LOG"; }
die()  { log "ERROR: $*"; echo "$*" >"$ERRFILE"; echo "ERROR: $*" >&2; exit 1; }
warn() { log "WARNING: $*"; echo "$*" >>"$NOTEFILE"; }
dlg()  { dialog --backtitle "$TITLE" "$@" 3>&1 1>&2 2>&3; }
in_target() { os_chroot "$@" >>"$LOG" 2>&1; }
as_user() { os_chroot runuser -l "$USERNAME" -c "$1" >>"$LOG" 2>&1; }

# plain chroot for systems without arch-chroot
chroot_mount() {
	local d
	for d in dev sys; do
		mountpoint -q "$MNT/$d" && continue
		mkdir -p "$MNT/$d"; mount --rbind "/$d" "$MNT/$d"; mount --make-rslave "$MNT/$d"
	done
	mountpoint -q "$MNT/proc" || { mkdir -p "$MNT/proc"; mount -t proc proc "$MNT/proc"; }
	if ! mountpoint -q "$MNT/run"; then
		mkdir -p "$MNT/run"; mount -t tmpfs tmpfs "$MNT/run"
		# udev database of the live system: dracut hostonly (Void, Gentoo) asks udev about the root
		# device and its drivers; arch-chroot binds all of /run for the same reason
		if [[ -d /run/udev ]]; then mkdir -p "$MNT/run/udev"; mount --bind /run/udev "$MNT/run/udev"; fi
	fi
	rm -f "$MNT/etc/resolv.conf"   # offline live system (UsrsideOS medium) may have none: then an empty file
	if [[ -e /etc/resolv.conf ]]; then cp -L /etc/resolv.conf "$MNT/etc/resolv.conf"; else : >"$MNT/etc/resolv.conf"; fi
}
chroot_run() {
	chroot "$MNT" /usr/bin/env -i HOME=/root TERM="${TERM:-linux}" LANG=C.UTF-8 \
		PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin "$@"
}

# a single lost ping is no reason to give up (weak Wi-Fi, VMs): 3 rounds, two targets
online() {
	local i h
	for i in 1 2 3; do
		for h in kernel.org github.com; do ping -c1 -W3 "$h" >/dev/null 2>&1 && return 0; done
		# ping may be blocked (NAT, qemu user network): HTTPS as a second try
		command -v curl >/dev/null && curl -fsS -m 8 -o /dev/null https://kernel.org/ 2>/dev/null && return 0
		sleep 2
	done
	return 1
}

requirements() {
	((EUID == 0)) || { echo "Please run as root from the live ISO." >&2; exit 1; }
	[[ -d /sys/firmware/efi/efivars ]] || { echo "Only UEFI is supported (boot the machine in UEFI mode)." >&2; exit 1; }
	# network is required, unless the backend can install offline (os_offline, e.g. UsrsideOS from its live medium)
	if ! online && ! { declare -F os_offline >/dev/null && os_offline; }; then
		echo "No internet. Connect first (iwctl / wpa_supplicant / net-setup / setup-interfaces)." >&2; exit 1
	fi
	os_live_tools
	: >"$LOG"; rm -f "$ERRFILE" "$NOTEFILE" /tmp/usrsideos-no-usrkrnl
}

# ---------------------------------------------------------------- detection
has_battery()  { compgen -G '/sys/class/power_supply/BAT*' >/dev/null; }
is_tuxedo_gen9() { [[ $(cat /sys/class/dmi/id/board_name 2>/dev/null) == GXxMRXx ]]; }
has_thunderbolt() { [[ -n $(ls /sys/bus/thunderbolt/devices 2>/dev/null) ]]; }
is_hybrid() { [[ -d /sys/devices/cpu_atom ]]; }
is_tuxedo() { grep -qi tuxedo /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor 2>/dev/null; }
has_gpu() {   # $1 PCI vendor id, e.g. 0x8086 Intel, 0x10de NVIDIA (display controllers only)
	local d
	for d in /sys/bus/pci/devices/*; do
		[[ $(cat "$d/class" 2>/dev/null) == 0x03* && $(cat "$d/vendor" 2>/dev/null) == "$1" ]] && return 0
	done
	return 1
}
hw_present() {
	case $1 in
		intel_media) has_gpu 0x8086 ;; nvidia) has_gpu 0x10de ;; bolt) has_thunderbolt ;; tuxedo) is_tuxedo ;; *) return 1 ;;
	esac
}
rapl_watts() {   # current long-term power limit (PL1) in W, empty if unknown
	local f=/sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw
	[[ -r $f ]] && echo $(($(<"$f") / 1000000))
}

# hardware-based hopd parts (desktop profile); only fills parts that are still empty
hopd_defaults() {
	local b=0; has_battery && b=1
	: "${H_STROM:=$b}" "${H_AKKULOG:=$b}"
	is_tuxedo_gen9 && : "${H_LUEFTER:=1}"
	: "${H_LUEFTER:=0}" "${H_EGPU:=0}"
	return 0
}
# hopd values from the hardware (used whenever a hopd part is chosen, in any profile)
hopd_values() {
	is_hybrid && H_ECORES=1
	local w; w=$(rapl_watts || true)
	if [[ -n $w ]] && ((w > 5)); then
		H_PL1_AC=$w H_PL2_AC=$((w * 13 / 10))
		H_PL1_BAT=$((w / 3 > 8 ? w / 3 : 8)); H_PL2_BAT=$((H_PL1_BAT + 8))
	fi
	return 0
}

# prints why DISK must not be erased (empty = fine); checked before anything destructive happens.
# The live medium is detected by its mounts (archiso bootmnt, Void /run/initramfs/live,
# Gentoo /mnt/cdrom …); mounts below $MNT are ours from an earlier attempt.
disk_problem() {
	local d=$1 m
	[[ -b $d ]] || { echo "$d is not a block device"; return; }
	[[ $(lsblk -dno TYPE "$d" 2>/dev/null) == disk ]] || { echo "$d is not a whole disk (lsblk TYPE disk)"; return; }
	while read -r m; do
		[[ -z $m || $m == "$MNT" || $m == "$MNT"/* ]] && continue
		echo "$d is in use (mounted at $m), probably the live medium"; return
	done < <(lsblk -nro MOUNTPOINTS "$d" 2>/dev/null)   # swap shows up as [SWAP]
}
# disk_problem/fs_problem for the callers: a check that fails itself is a problem, never "fine"
disk_check() { local p; p=$(disk_problem "$1") || p="${p:+$p; }the disk check failed"; echo "$p"; }
fs_check() { local p; p=$(fs_problem) || p="${p:+$p; }the filesystem check failed"; echo "$p"; }

# btrfs subvolume -> mount point
subvol_dir() { case $1 in @) echo / ;; @home) echo /home ;; @var_log) echo /var/log ;; @cache) echo /var/cache ;; @snapshots) echo /.snapshots ;; esac; }
btrfs_flat() { [[ $BTRFS_SUBVOLS == flat ]]; }

# prints what is wrong with FS / BTRFS_* (empty = fine)
fs_problem() {
	local s
	case $FS in
		xfs) return 0 ;;
		btrfs) ;;
		*) echo "FS=$FS: only btrfs or xfs"; return ;;
	esac
	if ! btrfs_flat; then
		for s in $BTRFS_SUBVOLS; do
			[[ $s != @ && -n $(subvol_dir "$s") ]] || { echo "BTRFS_SUBVOLS: unknown '$s' (@home @var_log @cache @snapshots or flat)"; return; }
		done
	fi
	[[ $BTRFS_COMPRESS =~ ^(zstd(:([1-9]|1[0-5]))?|lzo|none)$ ]] || echo "BTRFS_COMPRESS=$BTRFS_COMPRESS: zstd:1…zstd:15, lzo or none"
}

# mount options of the root fs; discard=async only on SSDs (ROTA 0)
fs_opts() {
	local o=noatime
	if [[ $FS == btrfs ]]; then
		[[ $BTRFS_COMPRESS == none ]] || o+=",compress=$BTRFS_COMPRESS"
		[[ $(lsblk -dno ROTA "$DISK" 2>/dev/null | tr -d ' ') == 0 ]] && o+=",discard=async"
	fi
	echo "$o"
}
fs_summary() {
	if [[ $FS == xfs ]]; then echo xfs
	elif btrfs_flat; then echo "btrfs flat, $BTRFS_COMPRESS"
	else echo "btrfs @ $BTRFS_SUBVOLS, $BTRFS_COMPRESS"; fi
}

# ---------------------------------------------------------------- options and profiles
opt_avail() { [[ -n ${PKG[$1]:-}${AUR[$1]:-} ]]; }
opt_on() { [[ ${SEL[$1]:-0} == 1 ]]; }
hopd_on() { ((H_STROM || H_AKKULOG || H_LUEFTER || H_EGPU || H_NIRI)); }
opt_label() {
	local i
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do [[ ${OPTIONS[i]} == "$1" ]] && break; done
	case $1 in browser) echo "${OPTIONS[i+3]} ($BROWSER_NAME)" ;; *) echo "${OPTIONS[i+3]}" ;; esac
}

# $1 minimal|desktop, $2 force (menu: overwrite everything) or fill (answers: keep what the file
# set, those keys count as explicitly chosen)
apply_profile() {
	local p=$1 mode=$2 i k v var
	EXPL=()
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		k=${OPTIONS[i]} var=${k^^}
		if [[ $mode == fill && -n ${!var:-} ]]; then SEL[$k]=${!var} EXPL[$k]=1; continue; fi
		v=0
		if [[ $p == desktop ]]; then
			case ${OPTIONS[i+2]} in on) v=1 ;; hw) hw_present "$k" && v=1 ;; esac
		fi
		SEL[$k]=$v
	done
	if [[ $mode == force ]]; then AUTOLOGIN="" USRKRNL="" H_STROM="" H_AKKULOG="" H_LUEFTER="" H_EGPU="" H_NIRI=""; fi
	[[ -z $AUTOLOGIN ]] || EXPL[autologin]=1
	[[ -z $H_NIRI ]] || EXPL[h_niri]=1
	if [[ $p == desktop ]]; then
		: "${AUTOLOGIN:=1}" "${H_NIRI:=1}"
		hopd_defaults
	fi
	: "${AUTOLOGIN:=0}" "${USRKRNL:=0}" "${H_STROM:=0}" "${H_AKKULOG:=0}" "${H_LUEFTER:=0}" "${H_EGPU:=0}" "${H_NIRI:=0}"
	PROFILE=$p
}

# state of an option or of the pseudo options autologin, h_niri (hopd niri part), extra_aur
st_on() {
	case $1 in
		autologin) ((AUTOLOGIN)) ;; h_niri) ((H_NIRI)) ;; extra_aur) ((${#EXTRA_AUR[@]})) ;; *) opt_on "$1" ;;
	esac
}
st_set() {   # $1 key, $2 0/1 (extra_aur is never switched)
	case $1 in autologin) AUTOLOGIN=$2 ;; h_niri) H_NIRI=$2 ;; extra_aur) ;; *) SEL[$1]=$2 ;; esac
}
st_label() {
	local l
	case $1 in
		autologin) echo "autologin + niri" ;; h_niri) echo "hopd niri part" ;; extra_aur) echo "the aur: packages" ;; *) l=$(opt_label "$1"); echo "${l%% (*}" ;;
	esac
}
# "needs" relations: option requirements, AUR packages -> yay, autologin/hopd niri part -> desktop
st_edges() {
	local i k r
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		k=${OPTIONS[i]}
		for r in ${OPTIONS[i+1]}; do echo "$k $r"; done
		[[ -z ${AUR[$k]:-} ]] || echo "$k yay"
	done
	echo "autologin desktop"; echo "h_niri desktop"; echo "extra_aur yay"
}

# Makes the selection consistent. An explicitly chosen value (answers key, change in the menu) always
# wins against a profile value: an option that needs something explicitly switched off is switched
# off too (DESKTOP=0 in the desktop profile drops waybar, autologin …); otherwise the missing part is
# switched on (WAYBAR=1 in the minimal profile brings niri). Both explicit = CONFLICT.
# RESOLVED/CONFLICT: one line per change/contradiction. Not in $(…): a subshell would lose SEL.
resolve_options() {
	local i k r changed=1 edges
	RESOLVED="" CONFLICT=""
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		k=${OPTIONS[i]}
		if opt_on "$k" && ! opt_avail "$k"; then
			SEL[$k]=0
			[[ -z ${EXPL[$k]:-} ]] || RESOLVED+="$(opt_label "$k"): not available on $OS_NAME"$'\n'
		fi
	done
	edges=$(st_edges)
	while ((changed)); do
		changed=0
		while read -r k r; do
			if ! st_on "$k" || st_on "$r"; then continue; fi
			if ! opt_avail "$r"; then
				st_set "$k" 0; changed=1
			elif [[ -n ${EXPL[$r]:-} && ( -n ${EXPL[$k]:-} || $k == extra_aur ) ]]; then
				[[ $CONFLICT == *"$(st_label "$k") needs"* ]] || CONFLICT+="$(st_label "$k") needs $(st_label "$r"), but $(st_label "$r") is switched off"$'\n'
			elif [[ -n ${EXPL[$r]:-} ]]; then
				st_set "$k" 0; changed=1; RESOLVED+="$(st_label "$k") switched off ($(st_label "$r") is off)"$'\n'
			else
				st_set "$r" 1; changed=1; RESOLVED+="$(st_label "$r") switched on (needed by $(st_label "$k"))"$'\n'
			fi
		done <<<"$edges"
	done
	RESOLVED=${RESOLVED%$'\n'} CONFLICT=${CONFLICT%$'\n'}
	return 0
}

# ---------------------------------------------------------------- menu entries
m_disk() {
	local list=() n s m
	while read -r n s m; do [[ -n $(disk_check "$n") ]] || list+=("$n" "$s ${m:-}"); done < <(lsblk -dpno NAME,SIZE,MODEL -e 7,11)
	((${#list[@]})) || die "No disk found."
	DISK=$(dlg --title "Disk" --menu "Choose the target. ALL DATA ON IT WILL BE ERASED.\n\nLayout: 1 GiB EFI + rest $(fs_summary) (menu: Filesystem).\nNo encryption: usrkrnl boots without initramfs." 18 72 8 "${list[@]}") || true
}
m_keyboard() {
	local k
	k=$(dlg --inputbox "Keyboard layout (e.g. de-latin1, us, es):" 8 60 "$KEYMAP") && KEYMAP=$k
	k=$(dlg --inputbox "Language (locale, e.g. en_US.UTF-8, de_DE.UTF-8, es_MX.UTF-8):" 8 60 "$LOCALE") && LOCALE=$k
	true
}
m_timezone() {
	local z
	z=$(dlg --inputbox "Time zone (e.g. Europe/Berlin, America/Mexico_City):" 8 60 "$TIMEZONE") || return 0
	[[ -f /usr/share/zoneinfo/$z ]] && TIMEZONE=$z || dlg --msgbox "Unknown time zone: $z" 6 50
}
m_hostname() { local r; r=$(dlg --inputbox "Hostname:" 8 50 "$HOSTNAME_") && [[ $r =~ ^[a-zA-Z0-9-]+$ ]] && HOSTNAME_=$r; true; }
m_user() {
	local n p1 p2
	n=$(dlg --inputbox "User name (lowercase, no spaces):" 8 50 "$USERNAME") || return 0
	[[ $n =~ ^[a-z_][a-z0-9_-]*$ ]] || { dlg --msgbox "Invalid name." 6 40; return 0; }
	p1=$(dlg --insecure --passwordbox "Password for $n (also used for sudo):" 8 50) || return 0
	p2=$(dlg --insecure --passwordbox "Repeat password:" 8 50) || return 0
	[[ -n $p1 && $p1 == "$p2" ]] || { dlg --msgbox "Passwords empty or different." 6 40; return 0; }
	USERNAME=$n PASSWORD=$p1
}
m_autologin() {
	if ! opt_on desktop; then
		dlg --yesno "Autologin starts niri, but the niri desktop is not selected.\n\nSwitch the niri desktop on?" 9 64 || { AUTOLOGIN=0 EXPL[autologin]=1; return 0; }
		SEL[desktop]=1 EXPL[desktop]=1
	fi
	if dlg --yesno "Log in automatically on tty1 and start niri?\n\n(The UsrsideOS way: power on → desktop. Locking is done by swaylock if installed.)" 10 64
	then AUTOLOGIN=1; else AUTOLOGIN=0; fi
	EXPL[autologin]=1
}
m_fs() {
	local f s c
	f=$(dlg --title "Filesystem" --default-item "$FS" --menu "Root filesystem (the EFI partition is always vfat):" 11 64 2 \
		btrfs "subvolumes, compression, snapshots" \
		xfs   "simple and fast, no subvolumes") || return 0
	FS=$f
	[[ $FS == btrfs ]] || return 0
	s=$(dlg --title "btrfs subvolumes" --checklist "Root is always @. Extra subvolumes (none selected = only @).\nChoose \"flat\" for no subvolumes at all." 15 66 5 \
		@home      /home        "$( [[ " $BTRFS_SUBVOLS " == *" @home "* ]] && echo on || echo off)" \
		@var_log   /var/log     "$( [[ " $BTRFS_SUBVOLS " == *" @var_log "* ]] && echo on || echo off)" \
		@cache     /var/cache   "$( [[ " $BTRFS_SUBVOLS " == *" @cache "* ]] && echo on || echo off)" \
		@snapshots /.snapshots  "$( [[ " $BTRFS_SUBVOLS " == *" @snapshots "* ]] && echo on || echo off)" \
		flat       "no subvolumes" "$(btrfs_flat && echo on || echo off)") || return 0
	s=$(echo $s | tr -d '"')
	if [[ " $s " == *" flat "* ]]; then BTRFS_SUBVOLS=flat; else BTRFS_SUBVOLS=$s; fi
	c=$(dlg --title "btrfs compression" --default-item "$BTRFS_COMPRESS" --menu "Compression (noatime is always set, discard=async on SSDs):" 13 64 5 \
		zstd:1 "fast, good ratio (default)" zstd:3 "better ratio, a bit slower" \
		zstd:9 "strong, slow writes" lzo "fastest, weaker" none "no compression") || return 0
	BTRFS_COMPRESS=$c
}
m_kernel() {
	local a
	if dlg --yesno "Build usrkrnl for this machine? (recommended)\n\nMinimized to the hardware, BORE, clang ThinLTO, no initramfs.\nTakes 10–40 minutes depending on the CPU. The $OS_NAME kernel from the installation stays\nas a frozen emergency backup entry; updates no longer touch it." 12 70
	then USRKRNL=1; else USRKRNL=0; fi
	a=$(dlg --inputbox "Extra kernel parameters (root= is set by the installer):" 8 70 "$KERNEL_ARGS") && KERNEL_ARGS=$a
	true
}
m_profile() {
	local p
	p=$(dlg --title "Profile" --default-item "${PROFILE:-minimal}" --menu "Start from a profile; every single option can be changed afterwards (Packages, Autologin, hopd, usrkrnl)." 12 76 2 \
		minimal "Minimal: text login, network, nothing else (like archinstall minimal)" \
		desktop "UsrsideOS desktop: niri, PulseAudio, waybar, rofi, tools, browser …") || return 0
	apply_profile "$p" force
}
m_packages() {
	local sel i k v list=() free
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		k=${OPTIONS[i]}
		opt_avail "$k" || continue
		list+=("$k" "$(opt_label "$k")$([[ ${OPTIONS[i+2]} == hw ]] && hw_present "$k" && echo " [detected]")" "$(on_off "${SEL[$k]:-0}")")
	done
	sel=$(dlg --separate-output --title "Packages" --checklist "Space = on/off. Needed parts are switched on automatically. Anything else can be installed later." 24 86 17 "${list[@]}") || return 0
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		k=${OPTIONS[i]}
		opt_avail "$k" || continue
		if grep -qxF "$k" <<<"$sel"; then v=1; else v=0; fi
		[[ $v == "${SEL[$k]:-0}" ]] || EXPL[$k]=1   # changed here = chosen explicitly
		SEL[$k]=$v
	done
	free=$(dlg --inputbox "More packages (space separated; $FREE_HINT):" 9 78 "$(printf '%s ' "${EXTRA_REPO[@]}" "${EXTRA_AUR[@]/#/aur:}")") || free=""
	EXTRA_REPO=() EXTRA_AUR=()
	for p in $free; do
		if [[ $p == aur:* ]]; then
			if ((OS_AUR)); then EXTRA_AUR+=("${p#aur:}"); else dlg --msgbox "AUR packages only work on Arch and UsrsideOS: $p skipped." 6 60; fi
		else EXTRA_REPO+=("$p"); fi
	done
	resolve_options
	[[ -z $RESOLVED$CONFLICT ]] || dlg --title "Selection" --msgbox "${CONFLICT:+Contradiction, please change:\n$CONFLICT\n\n}$RESOLVED" 16 84
}
m_hopd() {
	local sel list=() vals
	has_battery || dlg --msgbox "No battery found: power profiles and the battery log are mainly meant for laptops." 7 64
	list+=(strom "AC/battery profiles (power limits, brightness, power saving)" $( ((H_STROM)) && echo on || echo off))
	list+=(akkulog "Log battery drain (akku-log report)" $( ((H_AKKULOG)) && echo on || echo off))
	is_tuxedo_gen9 && list+=(luefter "Fan curves TUXEDO InfinityBook Pro Gen9" $( ((H_LUEFTER)) && echo on || echo off))
	has_thunderbolt && list+=(egpu "Wake Thunderbolt eGPU + log disconnects" $( ((H_EGPU)) && echo on || echo off))
	if opt_on desktop; then
		list+=(niri "niri session: lid, refresh rate, waybar, locking (needs waybar, lock screen)" $( ((H_NIRI)) && echo on || echo off))
	else H_NIRI=0; fi
	sel=$(dlg --separate-output --title "hopd – parts" --checklist "hopd is a small daemon (C) for power, fans and eGPU. Only the selected parts are compiled in." 18 90 6 "${list[@]}") || return 0
	for t in strom akkulog luefter egpu niri; do
		v=0; grep -qx "$t" <<<"$sel" && v=1
		case $t in strom) H_STROM=$v ;; akkulog) H_AKKULOG=$v ;; luefter) H_LUEFTER=$v ;; egpu) H_EGPU=$v ;; niri) H_NIRI=$v ;; esac
	done
	opt_on desktop && EXPL[h_niri]=1
	((H_STROM || H_NIRI)) || return 0
	vals=$(dlg --title "hopd – values" --form "Power in watts (Intel only, RAPL). Brightness -1 = leave alone.\nMode e.g. 2560x1600@60, empty = leave alone. Panel: niri name of the built-in screen." 20 78 9 \
		"Long-term power on AC (PL1)"  1 1 "$H_PL1_AC" 1 34 6 4 \
		"Peak power on AC (PL2)"       2 1 "$H_PL2_AC" 2 34 6 4 \
		"Long-term power on bat (PL1)" 3 1 "$H_PL1_BAT" 3 34 6 4 \
		"Peak power on battery (PL2)"  4 1 "$H_PL2_BAT" 4 34 6 4 \
		"Brightness on battery in %"   5 1 "$H_BRIGHT_BAT" 5 34 6 4 \
		"Panel (niri output)"          6 1 "$H_PANEL" 6 34 16 16 \
		"Mode on AC"                   7 1 "$H_MODE_AC" 7 34 20 24 \
		"Mode on battery"              8 1 "$H_MODE_BAT" 8 34 20 24 \
		"E-cores only on battery (0/1)" 9 1 "$H_ECORES" 9 34 3 1) || return 0
	mapfile -t w <<<"$vals"
	H_PL1_AC=${w[0]//[^0-9]/} H_PL2_AC=${w[1]//[^0-9]/} H_PL1_BAT=${w[2]//[^0-9]/} H_PL2_BAT=${w[3]//[^0-9-]/}
	H_BRIGHT_BAT=${w[4]//[^0-9-]/} H_PANEL=${w[5]//[^A-Za-z0-9-]/} H_MODE_AC=${w[6]//[^0-9x@.]/} H_MODE_BAT=${w[7]//[^0-9x@.]/} H_ECORES=${w[8]//[^01]/}
	# fields left empty: back to the defaults
	: "${H_PL1_AC:=45}" "${H_PL2_AC:=64}" "${H_PL1_BAT:=12}" "${H_PL2_BAT:=20}" "${H_BRIGHT_BAT:=-1}" "${H_PANEL:=eDP-1}" "${H_ECORES:=0}"
}

on_off() { (($1)) && echo on || echo off; }
main_menu() {
	local choice hparts n k extra
	while true; do
		hparts=""
		for t in STROM AKKULOG LUEFTER EGPU NIRI; do v=H_$t; ((${!v})) && hparts+="${t,,} "; done
		n=0; for k in "${!SEL[@]}"; do ((SEL[$k])) && n=$((n + 1)); done
		extra=(); if declare -F os_menu >/dev/null; then extra=(O "$(os_menu_label)"); fi
		choice=$(dlg --title "$TITLE" --cancel-label "Cancel" --menu "Base system: $OS_NAME. Set the options, then Install." 24 76 13 \
			P "Profile:          $PROFILE" \
			1 "Disk:             ${DISK:-(choose)}" \
			F "Filesystem:       $(fs_summary)" \
			2 "Keyboard/locale:  $KEYMAP, $LOCALE" \
			3 "Time zone:        $TIMEZONE" \
			4 "Hostname:         $HOSTNAME_" \
			5 "User:             ${USERNAME:-(create)}" \
			6 "Autologin + niri: $(on_off "$AUTOLOGIN")" \
			7 "hopd:             ${hparts:-off}" \
			8 "Packages:         $n selected$(opt_on desktop && echo ", niri desktop")" \
			9 "Build usrkrnl:    $(on_off "$USRKRNL")" \
			"${extra[@]}" \
			I "Install" \
			Q "Cancel") || exit 0
		case $choice in
			P) m_profile ;; 1) m_disk ;; F) m_fs ;; 2) m_keyboard ;; 3) m_timezone ;; 4) m_hostname ;; 5) m_user ;;
			6) m_autologin ;; 7) m_hopd ;; 8) m_extras ;; 9) m_kernel ;; O) os_menu ;;
			I) ready && return 0 ;;
			Q) exit 0 ;;
		esac
	done
}
ready() {
	[[ -n $DISK ]] || { dlg --msgbox "Choose a disk first." 6 40; return 1; }
	local p; p=$(disk_check "$DISK")
	[[ -z $p ]] || { dlg --msgbox "Cannot use this disk:\n$p" 8 64; return 1; }
	p=$(fs_check)
	[[ -z $p ]] || { dlg --msgbox "Filesystem settings:\n$p" 8 64; return 1; }
	[[ -n $USERNAME ]] || { dlg --msgbox "Create a user first." 6 40; return 1; }
	resolve_options
	[[ -z $CONFLICT ]] || { dlg --title "Selection" --msgbox "Contradiction, please change:\n$CONFLICT" 12 84; return 1; }
	[[ -z $RESOLVED ]] || dlg --title "Selection" --msgbox "$RESOLVED" 16 84
	dlg --defaultno --yesno "Install $OS_NAME + UsrsideOS now?\n\n$DISK will be ERASED COMPLETELY." 9 54
}

# ---------------------------------------------------------------- installation
step() { echo "XXX"; echo "$1"; echo "$2"; echo "XXX"; }

partition() {
	log "Partitioning $DISK"
	umount -R "$MNT" 2>/dev/null || true
	wipefs -af "$DISK" >>"$LOG" 2>&1
	printf 'label: gpt\nsize=1GiB, type=U, name=EFI\ntype=L, name=UsrsideOS\n' | sfdisk -q -W always "$DISK" >>"$LOG" 2>&1 ||
		die "partitioning $DISK failed"
	partprobe "$DISK" 2>/dev/null || true; udevadm settle 2>/dev/null || sleep 2
	mapfile -t PARTS < <(lsblk -lnpo NAME,TYPE "$DISK" | awk '$2 == "part" { print $1 }')
	ESP=${PARTS[0]} ROOT=${PARTS[1]}
	mkfs.fat -F32 -n EFI "$ESP" >>"$LOG" 2>&1
	# SUBVOLS: subvolumes to mount (root first); empty for xfs and flat btrfs
	local o s flags=""
	o=$(fs_opts)
	SUBVOLS=()
	log "Root filesystem: $(fs_summary), options $o"
	# always name the type: without -t mount only tries the filesystems already in /proc/filesystems
	# when probing fails, so a not yet loaded xfs module made it fail ("SQUASHFS superblock")
	if [[ $FS == xfs ]]; then
		mkfs.xfs -f -L usrside "$ROOT" >>"$LOG" 2>&1
		mount -t xfs -o "$o" "$ROOT" "$MNT"
	else
		mkfs.btrfs -f -L usrside "$ROOT" >>"$LOG" 2>&1
		if btrfs_flat; then
			mount -t btrfs -o "$o" "$ROOT" "$MNT"
		else
			# shellcheck disable=SC2206  # space separated list, checked by fs_problem
			SUBVOLS=(@ $BTRFS_SUBVOLS)
			mount -t btrfs "$ROOT" "$MNT"
			for s in "${SUBVOLS[@]}"; do btrfs subvolume create "$MNT/$s" >>"$LOG"; done
			umount "$MNT"
			for s in "${SUBVOLS[@]}"; do mount --mkdir -t btrfs -o "$o,subvol=$s" "$ROOT" "$MNT$(subvol_dir "$s")"; done
			flags=" rootflags=subvol=@"
		fi
	fi
	mount --mkdir -t vfat -o fmask=0077,dmask=0077 "$ESP" "$MNT/boot"
	PARTUUID=$(blkid -s PARTUUID -o value "$ROOT")
	ROOT_CMDLINE="root=PARTUUID=$PARTUUID rw$flags rootfstype=$FS $KERNEL_ARGS"
}

repo_list() {   # sets REPO from the settings; $1 = all: both microcode and root fs packages (--print-packages)
	local i f
	local fsp="FS_PKG_$FS"
	# shellcheck disable=SC2206  # may name several packages
	REPO=("${BASE[@]}" ${!fsp})
	if [[ ${1:-} == all ]]; then
		for f in FS_PKG_btrfs FS_PKG_xfs; do REPO+=(${!f:-}); done
		REPO+=($UCODE_INTEL $UCODE_AMD)
	elif grep -q GenuineIntel /proc/cpuinfo; then [[ -z $UCODE_INTEL ]] || REPO+=("$UCODE_INTEL")
	elif grep -q AuthenticAMD /proc/cpuinfo; then [[ -z $UCODE_AMD ]] || REPO+=("$UCODE_AMD"); fi
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		# shellcheck disable=SC2206  # a list of package names
		opt_on "${OPTIONS[i]}" && REPO+=(${PKG[${OPTIONS[i]}]:-})
	done
	# compiler + make for hopd, usrkrnl and AUR builds; the kernel build tools only for usrkrnl
	if ((USRKRNL)) || hopd_on || opt_on yay; then REPO+=("${BUILD_PKGS[@]}"); fi
	((USRKRNL)) && REPO+=("${KERNEL_PKGS[@]}")
	REPO+=("${EXTRA_REPO[@]}")
	[[ -z $TEST_SSH_KEY ]] || REPO+=("$SSH_PKG")
}

print_packages() {
	local inits=(-) init i k
	if [[ $OS == usrside ]]; then
		inits=(systemd busybox runit s6)
		# outside the live system: init paths only matter for the kernel line
		[[ -s $USRSIDE_INITS ]] || { USRSIDE_INITS=$(mktemp); printf '%s x\n' "${inits[@]}" >"$USRSIDE_INITS"; }
	fi
	for init in "${inits[@]}"; do (
		[[ $init == - ]] || INIT=$init
		for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
			k=${OPTIONS[i]}; if [[ $PRINT_WITHOUT == *" $k "* ]]; then SEL[$k]=0; else SEL[$k]=1; fi
		done
		PROFILE=desktop USRKRNL=1 AUTOLOGIN=1 H_STROM=1 H_AKKULOG=1 H_LUEFTER=1 H_EGPU=1 H_NIRI=1 TEST_SSH_KEY=x
		if declare -F os_prepare >/dev/null; then os_prepare >&2 || exit 1; fi
		repo_list all
		# tools the installer itself needs in the live system (os_live_tools)
		REPO+=(dialog dosfstools btrfs-progs xfsprogs efibootmgr)
		printf 'repo %s\n' "${REPO[@]}"
		if ((OS_AUR)) && opt_on yay && declare -p AUR >/dev/null 2>&1; then
			for k in "${!AUR[@]}"; do
				# shellcheck disable=SC2086  # a list of package names
				opt_on "$k" && printf 'aur %s\n' ${AUR[$k]}
			done
		fi
		exit 0
	) || exit 1; done | sort -u
}

packages() {
	local i
	repo_list
	os_bootstrap
	local ruuid euuid o s
	o=$(fs_opts)
	ruuid=$(blkid -s UUID -o value "$ROOT"); euuid=$(blkid -s UUID -o value "$ESP")
	{
		echo "# <device>  <mount point>  <type>  <options>  <dump>  <pass>"
		if ((${#SUBVOLS[@]})); then
			for s in "${SUBVOLS[@]}"; do echo "UUID=$ruuid  $(subvol_dir "$s")  btrfs  $o,subvol=$s  0 0"; done
		else
			echo "UUID=$ruuid  /  $FS  $o  0 0"   # xfs/btrfs need no fsck pass
		fi
		echo "UUID=$euuid  /boot  vfat  fmask=0077,dmask=0077  0 2"
	} >"$MNT/etc/fstab"
}

base_system() {
	log "Setting up the base system"
	ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MNT/etc/localtime"
	in_target hwclock --systohc || true
	os_locale
	[[ -n $(find "$MNT/usr/share/kbd/keymaps" "$MNT/usr/share/keymaps" -name "$KEYMAP.map*" 2>/dev/null | head -n1) ]] ||
		warn "Keyboard: keymap '$KEYMAP' not found in the target, the console keeps the default layout"
	grep -q "127.0.1.1" "$MNT/etc/hosts" 2>/dev/null ||
		printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_" >>"$MNT/etc/hosts"
	local groups g
	# pipefail: the loop must not end with the status of a missing last group
	groups=$(for g in wheel video input audio seat; do if os_chroot getent group "$g" >/dev/null; then echo "$g"; fi; done | paste -sd,)
	in_target useradd -m -G "$groups" -s /bin/bash "$USERNAME" || die "user could not be created"
	printf '%s:%s\n' "$USERNAME" "$PASSWORD" | os_chroot chpasswd
	in_target passwd -l root   # root locked without password, sudo via wheel
	if [[ -n $TEST_SSH_KEY ]]; then   # test mode: key login for root and the user
		in_target usermod -p '*' root
		local d
		for d in /root "/home/$USERNAME"; do
			mkdir -p "$MNT$d/.ssh"; echo "$TEST_SSH_KEY" >"$MNT$d/.ssh/authorized_keys"
			chmod 700 "$MNT$d/.ssh"; chmod 600 "$MNT$d/.ssh/authorized_keys"
		done
		os_chroot chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/.ssh"
		os_enable sshd
	fi
	mkdir -p "$MNT/etc/sudoers.d"
	echo '%wheel ALL=(ALL:ALL) ALL' >"$MNT/etc/sudoers.d/10-wheel"
	# only during the installation: package builds and usrkrnl without password. sudo applies the
	# LAST matching rule and reads sudoers.d in lexical order, so this must sort after 10-wheel.
	# install_all removes it on every exit, also after an abort.
	echo "$USERNAME ALL=(ALL:ALL) NOPASSWD: ALL" >"$MNT/etc/sudoers.d/$SUDO_TMP"
	chmod 440 "$MNT"/etc/sudoers.d/*

	# network: iwd does DHCP itself, DNS via systemd-resolved or openresolv; take over Wi-Fi known to iwd on the ISO
	mkdir -p "$MNT/etc/iwd" "$MNT/var/lib/iwd"
	printf '[General]\nEnableNetworkConfiguration=true\n\n[Network]\nNameResolvingService=%s\n' "$IWD_DNS" >"$MNT/etc/iwd/main.conf"
	cp -a /var/lib/iwd/. "$MNT/var/lib/iwd/" 2>/dev/null || true
	os_services
	os_extra_services

	# name, fastfetch logo
	install -Dm644 "$HERE/files/logo.txt" "$MNT/usr/share/usrsideos/logo.txt"
	install -Dm644 "$HERE/files/logo-small.txt" "$MNT/usr/share/usrsideos/logo-small.txt"
	rm -f "$MNT/etc/os-release"
	sed "s/^ID_LIKE=.*/ID_LIKE=${OS_LIKE:-$OS}/" "$HERE/files/os-release" >"$MNT/etc/os-release"

	# keep a copy of this repo (usrkrnl/setup, hopd) for later rebuilds and updates (git pull)
	mkdir -p "$MNT/home/$USERNAME/usrsideos"
	cp -a "$HERE/." "$MNT/home/$USERNAME/usrsideos/"
}

# niri config (desktop option), sound start, fastfetch logo, autologin
desktop() {
	local h=$MNT/home/$USERNAME c="" src
	if opt_on desktop; then
		log "Setting up niri"
		c=$h/.config/niri/config.kdl
		mkdir -p "${c%/*}"
		# Arch: /usr/share/doc/niri, Void: /usr/share/examples/niri
		# || true: find returns 1 when one of the directories is missing, pipefail would end the installation
		src=$(find "$MNT/usr/share/doc" "$MNT/usr/share/examples" -name 'default-config.kdl*' 2>/dev/null | head -n1 || true)
		case $src in
			*.bz2) bzip2 -dc "$src" ;;
			*.gz) gzip -dc "$src" ;;
			*.zst) zstd -qdc "$src" ;;
			"") niri_default_config ;;
			*) cat "$src" ;;
		esac | sed 's/"alacritty"/"kitty"/g' >"$c"
		if [[ -s $c ]]; then
			niri_config "$c"
		else
			rm -f "$c"; c=""
			warn "niri: no default config found, niri writes its own on first start (without the UsrsideOS changes: waybar/hopd/sound/lock autostart)"
		fi
	fi
	opt_on sound && os_sound "$c"
	if [[ -x $MNT/usr/bin/fastfetch ]]; then
		mkdir -p "$h/.config/fastfetch"
		printf '{\n  "logo": { "source": "/usr/share/usrsideos/logo-small.txt", "color": { "1": "37", "2": "96" } }\n}\n' >"$h/.config/fastfetch/config.jsonc"
	fi
	if ((AUTOLOGIN)) && opt_on desktop; then
		os_autologin
		cat >>"$h/.bash_profile" <<EOF

# UsrsideOS: start niri right away on tty1. Only from the interactive login shell: niri-session
# re-executes itself through "\$SHELL -l -c", which reads this file again and would loop forever.
if [[ \$- == *i* && -z \${WAYLAND_DISPLAY:-} && \$(tty) == /dev/tty1 ]]; then $SESSION_CMD; fi
EOF
	fi
	os_chroot chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"
}

# UsrsideOS changes to niri's default config, depending on the selected options
# default config of the installed niri release (Gentoo's GURU ebuild ships none). The one of
# the main branch can use newer syntax that this niri cannot parse ("release" binds,
# move-column-to-new-workspace-* in 26.04), so main is only the last resort.
# curl from the target: not every live ISO has curl or wget (Void has neither).
niri_default_config() {
	local v url=https://raw.githubusercontent.com/YaLTeR/niri
	v=$(os_chroot niri --version 2>/dev/null | awk '{ print $2; exit }' || true)
	if [[ $v =~ ^[0-9]+(\.[0-9]+)+$ ]] && os_chroot curl -fsSL "$url/v$v/resources/default-config.kdl" 2>/dev/null; then
		log "niri $v: default config of v$v downloaded"
		return 0
	fi
	log "niri ${v:-?}: no default config for this release, taking the one of the main branch"
	os_chroot curl -fsSL "$url/main/resources/default-config.kdl" 2>/dev/null || true
}

niri_config() {
	local c=$1 l='"swaylock" "-f" "-c" "1e2030"'   # same lock screen on every backend (swaybg colour)
	[[ -x $MNT/usr/bin/waybar ]] || sed -i 's/^spawn-at-startup "waybar"/\/\/ spawn-at-startup "waybar"/' "$c"
	if ((H_NIRI)); then   # hopd starts waybar (and locks with swaylock when the lid closes)
		sed -i 's/^\/\/ *spawn-at-startup "waybar"/spawn-at-startup "waybar"/; s/^spawn-at-startup "waybar"/spawn-at-startup "hopd" "sitzung"/' "$c"
	fi
	if opt_on rofi; then   # launcher on Mod+Space instead of fuzzel on Mod+D
		sed -i 's/^\( *\)Mod+D hotkey-overlay-title="[^"]*" { spawn "fuzzel"; }/\1Mod+Space hotkey-overlay-title="Run an Application: rofi" { spawn "rofi" "-show" "drun"; }/' "$c"
		sed -i 's/^\( *\)\(Mod+Space *{ switch-layout\)/\1\/\/ \2/' "$c"
	fi
	if opt_on lock; then   # Mod+L locks (focus right stays on Mod+Right)
		sed -i "s/^\\( *\\)Super+Alt+L hotkey-overlay-title=\"[^\"]*\" { spawn \"swaylock\"; }/\\1Mod+L hotkey-overlay-title=\"Lock the Screen: swaylock\" { spawn $l; }/" "$c"
		# focus right moves to Mod+D (and stays on Mod+Right), Mod+A is focus left (as on the UsrsideOS laptop)
		sed -i '/^ *Mod+D hotkey-overlay-title="[^"]*" { spawn "fuzzel"; }/d' "$c"
		sed -i 's/^\( *\)\(Mod+L *{ focus-column-right; }\)/\1\/\/ \2\n\1Mod+A     { focus-column-left; }\n\1Mod+D     { focus-column-right; }/' "$c"
		# idle lock; -f returns once the screen is locked, so before-sleep waits for it.
		# With the hopd niri part hopd also locks when the lid closes.
		echo 'spawn-at-startup "swayidle" "timeout" "600" "pidof swaylock || swaylock -f -c 1e2030" "before-sleep" "pidof swaylock || swaylock -f -c 1e2030"' >>"$c"
	fi
	opt_on polkit && echo "spawn-at-startup $POLKIT_SPAWN" >>"$c"
	opt_on swaybg && echo 'spawn-at-startup "swaybg" "-c" "#1e2030"' >>"$c"
	return 0
}

build_hopd() {
	if ! hopd_on; then
		warn "hopd: no part selected, not installed (later: ~/usrsideos/hopd, see README)"
		return 0
	fi
	log "Building hopd"
	local b=$MNT/usr/local/src/hopd
	mkdir -p "$b"; cp -r "$HERE/hopd/." "$b/"
	cp "$b/patches.def.h" "$b/patches.h"
	for t in STROM AKKULOG LUEFTER EGPU NIRI; do v=H_$t; sed -i "s/^#define PATCH_$t .*/#define PATCH_$t ${!v}/" "$b/patches.h"; done
	local c=$b/config.h
	cp "$b/config.def.h" "$c"
	sed -i "s/^static const char nutzer\[\] = .*/static const char nutzer[] = \"$USERNAME\";/" "$c"
	sed -i "s/^\(static const int   strom_pl1\[3\] *= \){[^}]*}/\1{ $H_PL1_AC, $H_PL1_BAT, $H_PL1_AC }/" "$c"
	sed -i "s/^\(static const int   strom_pl2\[3\] *= \){[^}]*}/\1{ $H_PL2_AC, $H_PL2_BAT, $H_PL2_AC }/" "$c"
	sed -i "s/^\(static const int   strom_hell\[3\] *= \){[^}]*}/\1{ -1, $H_BRIGHT_BAT, $H_BRIGHT_BAT }/" "$c"
	sed -i "s/^\(static const int   strom_nur_e\[3\] *= \){[^}]*}/\1{ 0, $H_ECORES, 0 }/" "$c"
	sed -i "s/^\(static const char \*strom_modus\[3\] *= \){[^}]*}/\1{ \"$H_MODE_AC\", \"$H_MODE_BAT\", \"$H_MODE_BAT\" }/" "$c"
	sed -i "s/^\(static const char  strom_panel\[\] *= \)\"[^\"]*\"/\1\"$H_PANEL\"/; s/^\(static const char niri_panel\[\] = \)\"[^\"]*\"/\1\"$H_PANEL\"/" "$c"
	in_target make -s -C /usr/local/src/hopd || die "hopd could not be built"
	in_target make -s -C /usr/local/src/hopd install PREFIX=/usr/local
	os_hopd_service
}

# put the first UEFI entry whose label contains $1 at the front of BootOrder
boot_first() {
	local e order
	e=$(efibootmgr | grep -F "$1" | sed -nE 's/^Boot([0-9A-Fa-f]{4}).*/\1/p' | head -n1)
	[[ -n $e ]] || return 1
	order=$(efibootmgr | awk '/^BootOrder/ { print $2 }' | tr ',' '\n' | grep -vix "$e" | paste -sd,)
	efibootmgr -q -o "$e${order:+,$order}" >>"$LOG" 2>&1
}

kernel() {
	log "Boot entries"
	local disk part cfg label="UsrsideOS ($OS_KERNEL_NAME kernel)"
	disk=/dev/$(lsblk -no PKNAME "$ESP"); part=$(<"/sys/class/block/$(basename "$ESP")/partition")
	# fallback: distribution kernel with initramfs under a fixed name, directly via EFI stub
	os_kernel_hook
	local initrd=" initrd=\\initramfs-$OS_KERNEL_NAME.img"
	if ((OS_INITRAMFS)); then
		[[ -f $MNT/boot/vmlinuz-$OS_KERNEL_NAME && -f $MNT/boot/initramfs-$OS_KERNEL_NAME.img ]] ||
			die "fallback kernel missing: /boot/vmlinuz-$OS_KERNEL_NAME + initramfs-$OS_KERNEL_NAME.img"
	else
		initrd=""   # the backend's fallback kernel boots without initramfs (root fs built in)
		[[ -f $MNT/boot/vmlinuz-$OS_KERNEL_NAME ]] || die "fallback kernel missing: /boot/vmlinuz-$OS_KERNEL_NAME"
	fi
	efibootmgr -q -c -d "$disk" -p "$part" -L "$label" -l "\\vmlinuz-$OS_KERNEL_NAME" \
		-u "$ROOT_CMDLINE$initrd" >>"$LOG" 2>&1 ||
		die "UEFI entry could not be created"
	boot_first "$label" || die "UEFI entry not found after creating it"
	((USRKRNL)) || return 0

	log "Downloading and building usrkrnl (takes a while)"
	# base = config of the installed distribution kernel (or of the running ISO kernel),
	# modules = what the ISO loaded for this hardware. The installed one comes first: the
	# Gentoo minimal ISO runs a stripped kernel without DRM, so nothing could keep the
	# GPU drivers (no /dev/dri, niri does not start). Arch ships no config file and uses
	# the ISO kernel, which is the normal Arch kernel.
	cfg=$MNT/home/$USERNAME/.config/usrkrnl
	mkdir -p "$cfg"
	# ls fails for the paths that do not exist; with pipefail that would end the installation
	local c; c=$(ls -t "$MNT"/boot/config-* "$MNT"/usr/src/linux-*/.config "$MNT"/usr/src/linux/.config 2>/dev/null | head -n1 || true)
	if [[ -n $c ]]; then cp "$c" "$cfg/base.config"; log "usrkrnl base config: ${c#"$MNT"}"
	elif [[ -r /proc/config.gz ]]; then zcat /proc/config.gz >"$cfg/base.config"; log "usrkrnl base config: /proc/config.gz (ISO kernel)"
	else die "no kernel config found as base for usrkrnl"
	fi
	lsmod >"$cfg/iso-lsmod"
	os_chroot chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/.config"
	local start why; start=$(($(wc -l <"$LOG") + 1))
	if as_user "~/usrsideos/usrkrnl/setup --base ~/.config/usrkrnl/base.config --modules ~/.config/usrkrnl/iso-lsmod --cmdline '$KERNEL_ARGS' --label UsrsideOS --bootnext"; then
		install -Dm755 "$HERE/files/usrkrnl-confirm" "$MNT/usr/local/bin/usrkrnl-confirm"
		os_confirm_service
		# the distribution kernel + initramfs from now on only as a frozen emergency backup:
		# package held, no initramfs is ever generated again (not even by firmware updates)
		log "Freezing the $OS_NAME kernel as emergency backup"
		os_freeze_kernel || warn "the $OS_NAME kernel could not be frozen; updates may still rebuild it (see the log)"
	else
		# the reason = last error line of usrkrnl/setup in the log (without colour codes)
		why=$(tail -n +"$start" "$LOG" | sed 's/\x1b\[[0-9;]*m//g' | grep -E '==> ERROR:|usrkrnl/setup: unexpected error' | tail -n1 | sed 's/^==> ERROR: //' || true)
		log "WARNING: usrkrnl build failed: ${why:-see above}"
		echo "${why:-unknown, see the log}" >/tmp/usrsideos-no-usrkrnl
	fi
}

cleanup() {
	rm -f "$MNT/etc/sudoers.d/$SUDO_TMP"
	os_finish
	cp "$LOG" "$MNT/var/log/usrsideos-install.log"
	sync
	umount -R "$MNT" 2>/dev/null || umount -Rl "$MNT" 2>/dev/null || true
}

install_all() {
	(
		set -eE
		trap 'echo "Unexpected error in line $LINENO: $BASH_COMMAND" >"$ERRFILE"' ERR
		# never leave passwordless sudo in the target, also when the installation aborts
		trap 'rm -f "$MNT/etc/sudoers.d/$SUDO_TMP"' EXIT
		step 5 "Preparing the disk …";       partition
		step 15 "Installing $OS_NAME …";      packages
		step 45 "Setting up the system …";   base_system
		step 50 "Setting up niri …";         desktop
		step 55 "Community packages …";      os_community
		step 70 "Building hopd …";           build_hopd
		step 75 "Boot entries, usrkrnl (10–40 min) …"; kernel
		step 98 "Cleaning up …";             cleanup
		step 100 "Done."
	)
}

finish_msg() {
	local m="UsrsideOS ($OS_NAME) is installed.\n\nRemove the USB stick and reboot."
	opt_on desktop || m+="\n\nNo desktop selected: after the reboot you get a text login. Wi-Fi: iwctl, wired network works by itself.\nLater: install niri etc. with the package manager, or reinstall with the desktop profile."
	if [[ -e /tmp/usrsideos-no-usrkrnl ]]; then
		m+="\n\nWARNING: usrkrnl could not be built – the $OS_NAME kernel is used.\nReason: $(cat /tmp/usrsideos-no-usrkrnl)\nDetails: /var/log/usrsideos-install.log and ~/.local/src/usrkrnl/linux-*/.usrkrnl/build.log\nTry again later: ~/usrsideos/usrkrnl/setup"
	elif ((USRKRNL)); then
		m+="\nThe first boot uses usrkrnl; if it works, usrkrnl becomes the default.\nOtherwise the next boot uses the $OS_NAME kernel.\nThe $OS_NAME kernel stays a frozen emergency backup (no updates)."
	fi
	if [[ -s $NOTEFILE ]]; then
		m+="\n\nNote:"
		while IFS= read -r l; do m+="\n- $l"; done <"$NOTEFILE"
		m+="\nDetails: /var/log/usrsideos-install.log"
	fi
	echo -e "$m"
}

if ((PRINT)); then set -o pipefail; print_packages; exit; fi
requirements
hopd_values
# backends without a green VM test yet; remove an ID here once its test has passed
case $OS in
	gentoo|alpine|usrside)
		log "NOTE: the $OS_NAME backend is experimental and untested"
		if [[ -z $ANSWERS ]]; then
			dlg --title "Experimental" --defaultno --yesno "The $OS_NAME backend is experimental and untested.\n\nThe installation may fail or leave an unbootable system. Only the Arch and Void backends have been fully tested so far.\n\nContinue anyway?" 12 70 || exit 0
		fi ;;
esac
if [[ -n $ANSWERS ]]; then
	# shellcheck disable=SC1090
	. "$ANSWERS"
	[[ -z ${AUR:-} ]] || : "${YAY:=$AUR}"
	bad=""
	for ((i = 0; i < ${#OPTIONS[@]}; i += 4)); do
		v=${OPTIONS[i]^^}; [[ -z ${!v:-} || ${!v} == [01] ]] || bad+=" $v=${!v}"
	done
	for v in AUTOLOGIN USRKRNL H_STROM H_AKKULOG H_LUEFTER H_EGPU H_NIRI; do [[ -z ${!v:-} || ${!v} == [01] ]] || bad+=" $v=${!v}"; done
	[[ -z $bad ]] || { echo "--answers: only 0 or 1 (or empty) allowed:$bad" >&2; exit 1; }
	case ${PROFILE:-minimal} in minimal|desktop) ;; *) echo "--answers: PROFILE=$PROFILE: minimal or desktop" >&2; exit 1 ;; esac
	if ((!OS_AUR && ${#EXTRA_AUR[@]})); then log "--answers: EXTRA_AUR ignored (AUR only on Arch and UsrsideOS)"; EXTRA_AUR=(); fi
	if declare -F os_answers >/dev/null; then os_answers || exit 1; fi
	apply_profile "${PROFILE:-minimal}" fill
	resolve_options
	[[ -z $CONFLICT ]] || { log "--answers: $CONFLICT"; echo "--answers: $CONFLICT" >&2; exit 1; }
	[[ -z $RESOLVED ]] || while IFS= read -r l; do log "--answers: $l"; done <<<"$RESOLVED"
	log "--answers: profile $PROFILE, options: $(for k in "${!SEL[@]}"; do ((SEL[$k])) && printf '%s ' "$k"; done)"
	[[ -n $DISK && -n $USERNAME && -n $PASSWORD ]] || { echo "--answers: DISK, USERNAME and PASSWORD are required" >&2; exit 1; }
	p=$(disk_check "$DISK")
	[[ -z $p ]] || { log "--answers: DISK rejected: $p"; echo "--answers: DISK rejected: $p" >&2; exit 1; }
	p=$(fs_check)
	[[ -z $p ]] || { log "--answers: $p"; echo "--answers: $p" >&2; exit 1; }
	if declare -F os_prepare >/dev/null; then os_prepare || exit 1; fi
	set +e; install_all >/dev/null; st=$?; set -e
	if ((st)); then echo "Installation aborted: $(cat "$ERRFILE" 2>/dev/null) (log: $LOG)" >&2; exit 1; fi
	finish_msg
	exit 0
fi
apply_profile minimal force
main_menu
if declare -F os_prepare >/dev/null; then os_prepare || exit 1; fi
set +e
install_all | dialog --backtitle "$TITLE" --title "Installation" --gauge "Here we go …" 9 70 0
st=${PIPESTATUS[0]}
set -e
if [[ $st != 0 ]]; then
	dlg --title "Error" --msgbox "Installation aborted:\n$(cat "$ERRFILE" 2>/dev/null)\n\nLog: $LOG" 12 70; exit 1
fi
dlg --msgbox "$(finish_msg)" 20 76
